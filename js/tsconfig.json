{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "@testing-library/jest-dom/vitest"
    ]
  },
  "include": [
    "src",
    "tests",
    "vitest.config.ts",
    "svelte.config.js"
  ]
}

{
  "name": "@jmerhar/jigkit",
  "version": "0.8.1",
  "description": "The shared browser foundations of small self-hosted web apps: theme, language, API client, formatting and passkeys",
  "license": "MIT",
  "author": "Jure Merhar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmerhar/jigkit.git",
    "directory": "js"
  },
  "homepage": "https://github.com/jmerhar/jigkit",
  "bugs": "https://github.com/jmerhar/jigkit/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./i18n/build": {
      "types": "./dist/i18n/build.d.ts",
      "default": "./dist/i18n/build.js"
    },
    "./i18n/testing": {
      "types": "./dist/i18n/testing.d.ts",
      "default": "./dist/i18n/testing.js"
    },
    "./passkeys": {
      "types": "./dist/passkeys.d.ts",
      "default": "./dist/passkeys.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@simplewebauthn/browser": ">=13 <15"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

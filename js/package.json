{
  "name": "@jmerhar/jigkit",
  "version": "0.17.0-dev.0",
  "description": "The shared browser foundations of small self-hosted web apps: theme, language, API client, formatting, passkeys, and Svelte login screens",
  "license": "MIT",
  "author": "Jure Merhar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmerhar/jigkit.git",
    "directory": "js"
  },
  "homepage": "https://github.com/jmerhar/jigkit",
  "bugs": "https://github.com/jmerhar/jigkit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./auth/svelte": {
      "types": "./dist/auth/svelte/index.d.ts",
      "svelte": "./dist/auth/svelte/index.js",
      "default": "./dist/auth/svelte/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./i18n/build": {
      "types": "./dist/i18n/build.d.ts",
      "default": "./dist/i18n/build.js"
    },
    "./i18n/testing": {
      "types": "./dist/i18n/testing.d.ts",
      "default": "./dist/i18n/testing.js"
    },
    "./nav/svelte": {
      "types": "./dist/nav/svelte/index.d.ts",
      "svelte": "./dist/nav/svelte/index.js",
      "default": "./dist/nav/svelte/index.js"
    },
    "./passkeys": {
      "types": "./dist/passkeys.d.ts",
      "default": "./dist/passkeys.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./styles/base.css": "./dist/styles/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@simplewebauthn/browser": ">=13 <15",
    "svelte": ">=5.40 <6"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

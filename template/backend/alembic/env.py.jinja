"""Alembic environment: jigkit's, pointed at this application's database and models.

jigkit runs the migrations with SQLite's foreign keys off while a table is rebuilt, so rebuilding
``user`` keeps everyone's sessions, passkeys and notes, and checks them afterwards.
"""

from jigkit.migrations import run_migrations

from {{ package }}.config import get_settings
from {{ package }}.models import Base

run_migrations(get_settings().resolved_database_url, Base.metadata)

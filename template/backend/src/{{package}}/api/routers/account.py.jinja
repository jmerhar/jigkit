"""The logged-in user's own account: their name and language, password, and a test notification."""

from fastapi import APIRouter, HTTPException, status
from jigkit.auth import PasswordTooShort, hash_password, verify_password

from ...auth import SESSIONS
from .. import cookies
from ..deps import DbDep, ServicesDep, SessionDep
from ..schemas import LANGUAGES, Me, MeUpdate, PasswordChange

router = APIRouter(prefix="/account", tags=["account"])

#: The title of the notifications the application sends.
TITLE = "{{ app_title }}"


@router.put("")
async def update_account(body: MeUpdate, session: SessionDep, services: ServicesDep) -> Me:
    """Change the user's name, and the language the interface uses for them."""
    user = session.user
    user.name = body.name.strip()
    user.language = body.language if body.language in LANGUAGES else None
    return cookies.describe(user, services.settings)


@router.put("/password", status_code=status.HTTP_204_NO_CONTENT)
async def change_password(body: PasswordChange, session: SessionDep, db: DbDep) -> None:
    """Change the password, given the current one, and log out every other browser."""
    user = session.user
    if not verify_password(user.password_hash, body.current):
        raise HTTPException(status.HTTP_403_FORBIDDEN, "wrong_password")
    try:
        user.password_hash = hash_password(body.new)
    except PasswordTooShort:
        raise HTTPException(status.HTTP_422_UNPROCESSABLE_CONTENT, "password_too_short") from None
    await SESSIONS.end_all(db, user.id, keep=session.id)


@router.post("/test-notification", status_code=status.HTTP_204_NO_CONTENT)
async def test_notification(session: SessionDep, services: ServicesDep) -> None:
    """Send a notification to NOTIFY_URL, to check it arrives."""
    url = services.settings.notify_url
    if not url:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "notifications_off")
    body = f"A test notification for {session.user.name}."
    sent = await services.sender.send([url], TITLE, body)
    if not sent:
        raise HTTPException(status.HTTP_502_BAD_GATEWAY, "notification_failed")

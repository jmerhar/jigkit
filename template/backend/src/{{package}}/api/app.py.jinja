"""The application factory."""

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

from fastapi import FastAPI, Request
from jigkit.notify import Sender
from jigkit.web import health_router, install_security_headers, install_write_guard, mount_spa
from sqlalchemy import text

from .. import __version__
from ..auth import WRITE_HEADER_VALUE
from ..config import Settings, get_settings
from .deps import build_services
from .routers import account, auth, notes, passkeys, setup

API_PREFIX = "/api"


def create_app(settings: Settings | None = None, sender: Sender | None = None) -> FastAPI:
    """Build the application for ``settings``, or the environment's when none are given.

    ``sender`` delivers notifications; Apprise unless a test passes its own.
    """
    settings = settings or get_settings()

    @asynccontextmanager
    async def lifespan(app: FastAPI) -> AsyncIterator[None]:
        services = build_services(settings, sender)
        app.state.services = services
        try:
            yield
        finally:
            await services.engine.dispose()

    app = FastAPI(
        title="{{ app_title }}",
        summary="{{ description }}",
        version=__version__,
        lifespan=lifespan,
        docs_url=f"{API_PREFIX}/docs",
        redoc_url=None,
        openapi_url=f"{API_PREFIX}/openapi.json",
    )
    app.include_router(
        health_router(check_database, version=__version__, revision=settings.revision),
        prefix=API_PREFIX,
    )
    # Each route that acts on an account asks for the session itself (SessionDep or UserDep);
    # setup and the two logins are the only routes open without one.
    for module in (setup, auth, passkeys, account, notes):
        app.include_router(module.router, prefix=API_PREFIX)
    # Every write needs the interface's header and, with an Origin, the app's own; with the
    # SameSite=Lax session cookie this is the second of two locks against cross-site writes.
    install_write_guard(
        app, value=WRITE_HEADER_VALUE, public_url=settings.public_url, prefix=API_PREFIX
    )
    install_security_headers(app)
    mount_spa(app, settings.static_dir, api_prefix=API_PREFIX)
    return app


async def check_database(request: Request) -> None:
    """Run a trivial query, raising if the database cannot answer."""
    async with request.app.state.services.engine.connect() as connection:
        await connection.execute(text("SELECT 1"))

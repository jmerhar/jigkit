.PHONY: install dev up down logs shell build test test-backend test-frontend coverage lint openapi \
        contract check migrate revision lockfile release clean

# help, devtools-update and coverage-tooling come from jmerhar/devtools; make fetches them on the
# first run and whenever devtools.toml changes.
.DEFAULT_GOAL := help
include .devtools/make/devtools.mk
.devtools/make/devtools.mk: devtools.toml bin/devtools-fetch.sh
	bin/devtools-fetch.sh

##@ Setup

# node_modules is installed through whatever registry this machine's npm reaches, without touching
# the lockfile, which records only the public registry.
install: ## Create the backend virtualenv and install the frontend packages
	python3 -m venv backend/.venv
	backend/.venv/bin/pip install --quiet --upgrade pip
	backend/.venv/bin/pip install --quiet -e "backend[test]"
	cd frontend && npm ci --no-audit --no-fund --registry="$$(cd / && npm config get registry)"

##@ Development

dev: ## Start the stack with hot reload (API on :8000, interface on :5173)
	.devtools/bin/dev.sh

up: ## Build and start the production stack
	docker compose -f docker-compose.yml -f docker-compose.build.yml up --build -d
	@echo "Interface: http://127.0.0.1:8000"

down: ## Stop the stack, keeping the data
	docker compose down

logs: ## Follow the container's log
	docker compose logs -f

shell: ## Open a shell in the running container
	docker compose exec {{ app_slug }} sh

build: ## Build the image without starting anything
	docker compose -f docker-compose.yml -f docker-compose.build.yml build

##@ Testing

test: test-backend test-frontend ## Run both test suites

test-backend: ## Run the backend suite (ARGS pass through to pytest)
	bin/test-backend.sh $(ARGS)

test-frontend: ## Type-check the interface and run its suite
	bin/test-frontend.sh $(ARGS)

coverage: ## Run both suites with coverage and print the combined summary
	bin/coverage.sh --format md

lint: ## ShellCheck, ruff, the lockfile, versions and compose files
	.devtools/bin/lint.sh

openapi: ## Re-export the API schema and regenerate the interface's types
	.devtools/bin/openapi.sh

contract: openapi ## Check the committed schema and generated types are up to date
	@git diff --exit-code frontend/openapi.json frontend/src/lib/api-types.ts \
		|| (echo "The schema or the types changed: commit them." >&2; exit 1)

check: lint contract coverage ## Everything (gate a commit on this)

##@ Database

migrate: ## Apply migrations to the development database in data/
	bin/migrate.sh

revision: ## Create a migration from the models: make revision M="add a column"
	bin/migrate.sh revision --autogenerate -m "$(M)"

##@ Releasing

lockfile: ## Regenerate package-lock.json (Linux binaries, public registry URLs)
	.devtools/bin/lockfile.sh

release: ## Cut a release: make release V=X.Y.Z (commits and tags; pushing publishes)
	.devtools/bin/release.sh $(V)

##@ Housekeeping

clean: ## Remove test, coverage and build output
	rm -rf backend/htmlcov backend/coverage.json backend/coverage.xml backend/.coverage* \
		backend/junit backend/.pytest_cache frontend/coverage frontend/dist frontend/src/paraglide

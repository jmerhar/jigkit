# Builds the image from this working copy instead of pulling the published one.
#
# Kept out of docker-compose.yml so that file stands alone: someone running {{ app_title }} needs
# nothing but the compose file, and `docker compose up` would fail on a build context they have
# not got.
services:
  {{ app_slug }}:
    build:
      context: .
      args:
        NPM_REGISTRY: ${NPM_REGISTRY:-}

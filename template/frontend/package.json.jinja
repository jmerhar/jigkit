{
  "name": "{{ app_slug }}-web",
  "private": true,
  "version": "0.1.0-dev.0",
  "description": "{{ app_title }}'s interface: a thin client of its API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node build/compile-messages.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.5.6",
    "@jmerhar/frontend-config": "^0.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@jmerhar/jigkit": "{{ jigkit_version }}",
    "@lucide/svelte": "1.67.0",
    "@simplewebauthn/browser": "14.0.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}

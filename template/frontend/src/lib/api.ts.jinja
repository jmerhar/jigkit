/**
 * The API client. Its types come from the API's own OpenAPI schema (api-types.ts, generated by
 * `make openapi`), so a changed response shape fails type-checking here instead of at runtime.
 */

import { ApiClient, writeHeader } from "@jmerhar/jigkit/api";
import type { components } from "./api-types";

export { ApiError } from "@jmerhar/jigkit/api";

type Schemas = components["schemas"];
export type Me = Schemas["Me"];
export type Note = Schemas["NoteOut"];
export type NoteIn = Schemas["NoteIn"];
export type Passkey = Schemas["PasskeyOut"];
export type SessionOut = Schemas["SessionOut"];

/** The header every write carries; the API refuses a write without it. */
export const WRITE_HEADER = writeHeader("{{ app_slug }}");

/** One method per endpoint, on jigkit's client: JSON in and out, and failures as ApiError. */
export class Api extends ApiClient {
  constructor(base = "/api", fetcher?: typeof fetch) {
    super({ base, fetcher, writeHeader: WRITE_HEADER });
  }

  setupState = () => this.request<Schemas["SetupState"]>("GET", "/setup");
  setUp = (body: Schemas["SetupIn"]) => this.request<Me>("POST", "/setup", body);
  logIn = (login: string, password: string) => this.request<Me>("POST", "/auth/login", { login, password });
  logOut = () => this.request<void>("POST", "/auth/logout");
  me = () => this.request<Me>("GET", "/auth/me");

  updateAccount = (body: Schemas["MeUpdate"]) => this.request<Me>("PUT", "/account", body);
  changePassword = (current: string, next: string) =>
    this.request<void>("PUT", "/account/password", { current, new: next });
  testNotification = () => this.request<void>("POST", "/account/test-notification");

  passkeys = () => this.request<Passkey[]>("GET", "/auth/passkeys");
  passkeyOptions = () => this.request<Record<string, unknown>>("POST", "/auth/passkeys/options");
  addPasskey = (label: string, credential: unknown) =>
    this.request<Passkey>("POST", "/auth/passkeys", { label, credential });
  removePasskey = (id: number) => this.request<void>("DELETE", `/auth/passkeys/${id}`);
  passkeyLoginOptions = () => this.request<Record<string, unknown>>("POST", "/auth/passkey-login/options");
  passkeyLogIn = (credential: unknown) => this.request<Me>("POST", "/auth/passkey-login", { credential });

  notes = () => this.request<Note[]>("GET", "/notes");
  createNote = (body: NoteIn) => this.request<Note>("POST", "/notes", body);
  updateNote = (id: number, body: NoteIn) => this.request<Note>("PUT", `/notes/${id}`, body);
  deleteNote = (id: number) => this.request<void>("DELETE", `/notes/${id}`);
}
